ENVIRONMENT=development
DEBUG=true

# Postgres
DATABASE_URL=postgresql+asyncpg://nasrcash:nasrcash@localhost:5432/nasrcash
DATABASE_URL_SYNC=postgresql+psycopg2://nasrcash:nasrcash@localhost:5432/nasrcash

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Sandbox
SANDBOX_MODE=true
KYC_STORAGE_PATH=./storage/kyc

# Default country/currency for the pilot market
DEFAULT_COUNTRY_CODE=GN
DEFAULT_CURRENCY_CODE=GNF

# Auth security
OTP_EXPIRE_SECONDS=300
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Fees
TOPUP_FEE_PERCENT=0.02
PAYMENT_FEE_PERCENT=0.03
WITHDRAWAL_FEE_PERCENT=0.015

# Bootstrap admin account (change immediately outside sandbox)
ADMIN_BOOTSTRAP_EMAIL=admin@nasrcash.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
